# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=TrivaroPayBot
TELEGRAM_WEBHOOK_SECRET=generate_a_random_secret_string

# Blockchain APIs
TRONGRID_API_KEY=your_trongrid_api_key
BLOCKCYPHER_TOKEN=your_blockcypher_token

# Resend (email)
RESEND_API_KEY=your_resend_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Trivaro
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=TrivaroPayBot

# Wallet (hot wallet for receiving payments)
# These must match app_config.hot_wallet_* — the database value is the runtime
# source of truth for create_order() and verify-payment. These are fallbacks
# for the verifier, but the PRIMARY source for telegram-webhook.
# NOTE: the verifier reads HOT_WALLET_USDC_ERC20, not HOT_WALLET_USDC_BASE.
HOT_WALLET_BTC=your_btc_wallet_address
HOT_WALLET_USDT_TRC20=your_usdt_trc20_wallet_address
HOT_WALLET_USDC_ERC20=your_usdc_erc20_wallet_address

# MT5 Integration
MT5_API_SECRET=generate_a_random_secret_for_mt5_bridge_auth
EDGE_FUNCTION_API_KEY=generate_a_random_secret_for_edge_function_auth
