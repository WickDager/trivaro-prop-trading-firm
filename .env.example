# Supabase
# Both keys must be the NEW-format keys from Settings -> API Keys:
#   publishable -> sb_publishable_...   (browser-safe; ships in the JS bundle)
#   secret      -> sb_secret_...        (server only; never a NEXT_PUBLIC_ var)
# Legacy anon / service_role JWTs (eyJ...) are disabled project-side and are
# rejected by the app, the MT5 bridge and the Telegram bot.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=TrivaroPayBot
TELEGRAM_WEBHOOK_SECRET=generate_a_random_secret_string

# Blockchain APIs
# ALL THREE rails verify with NO key: USDT-TRC20 reads TronGrid, BTC reads
# mempool.space (Blockstream Esplora fallback), and USDC-ERC20 reads the
# Etherscan-shaped explorers below. A missing secret therefore cannot disable a
# way to pay.
# TRONGRID_API_KEY is optional; it only raises TronGrid's rate limit.
TRONGRID_API_KEY=your_trongrid_api_key

# Optional. Etherscan switched its keyless v1 endpoint off on 2025-08-15 and
# requires a key on v2 (api.etherscan.io/v2/api), which is why ERC20
# verification used to find nothing. The verifier no longer depends on it: it
# falls back to keyless Etherscan-shaped mirrors (Routescan, then Blockscout).
# Set a key only to prefer Etherscan's index. Free tier: 3 calls/second.
ETHERSCAN_API_KEY=

# Pinned token contracts (both optional; these are the defaults)
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDC_ERC20_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Optional. Pins ONE etherscan-compatible endpoint for the Ethereum rail
# (a self-hosted Blockscout, an explorer proxy). Unset uses the keyless mirrors
# in the verifier: Routescan first, then Blockscout. BTC_API_BASE is the
# Bitcoin equivalent and likewise optional.
ETH_API_BASE=

# BTC price feed
# BTC is quoted in USD, so create_order() converts the fee with a rate stored in
# app_config.btc_usd_rate that is refreshed from the keyless Coinbase spot quote
# by POST /api/rates/refresh. The checkout refreshes a stale rate on its own;
# this secret lets a scheduled job keep the feed warm instead (sent as
# `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=generate_a_random_secret_string

# Resend (email)
RESEND_API_KEY=your_resend_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Trivaro
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=TrivaroPayBot

# Wallet (hot wallet for receiving payments)
# These must match app_config.hot_wallet_* — the database value is the runtime
# source of truth for create_order(), verify-payment, telegram-webhook and the
# Telegram bot, all of which read app_config first. These are FALLBACKS only.
# NOTE: the verifier reads HOT_WALLET_USDC_ERC20, not HOT_WALLET_USDC_BASE.
HOT_WALLET_BTC=your_btc_wallet_address
HOT_WALLET_USDT_TRC20=your_usdt_trc20_wallet_address
HOT_WALLET_USDC_ERC20=your_usdc_erc20_wallet_address

# MT5 Integration
MT5_API_SECRET=generate_a_random_secret_for_mt5_bridge_auth
EDGE_FUNCTION_API_KEY=generate_a_random_secret_for_edge_function_auth
